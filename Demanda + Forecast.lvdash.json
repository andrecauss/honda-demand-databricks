    {
      "name": "a2ab11cf",
      "displayName": "Material 11395K1ZJ11: Demanda Real + Forecasts (Julho, Agosto, Setembro)",
      "queryLines": [
        "WITH historico AS (\n",
        "    SELECT \n",
        "        DATE_TRUNC('MONTH', `data_ordem`) as mes,\n",
        "        SUM(`quantidade`) as demanda_real,\n",
        "        CAST(NULL AS DOUBLE) as forecast_julho,\n",
        "        CAST(NULL AS DOUBLE) as forecast_agosto,\n",
        "        CAST(NULL AS DOUBLE) as forecast_setembro\n",
        "    FROM `parts_hdbk_sandbox`.`_agents_databases`.`demand_analytical_base`\n",
        "    WHERE 1=1\n",
        "        AND (:material IS NULL OR item_principal_cadeia = :material)\n",
        "        AND `data_ordem` >= '2024-10-01' \n",
        "        AND `data_ordem` < '2026-10-01'\n",
        "    GROUP BY DATE_TRUNC('MONTH', `data_ordem`)\n",
        "),\n",
        "forecast_jul AS (\n",
        "    SELECT \n",
        "        `forecast_month` as mes,\n",
        "        CAST(NULL AS DOUBLE) as demanda_real,\n",
        "        SUM(`forecast_qty`) as forecast_julho,\n",
        "        CAST(NULL AS DOUBLE) as forecast_agosto,\n",
        "        CAST(NULL AS DOUBLE) as forecast_setembro\n",
        "    FROM `parts_hdbk_sandbox`.`_agents_databases`.`forecast_enriched`\n",
        "    WHERE 1=1\n",
        "        AND (:material IS NULL OR main_material = :material)\n",
        "        AND `forecast_cycle` = '2026-07-01'\n",
        "        AND `lag` <= 11\n",
        "    GROUP BY `forecast_month`\n",
        "),\n",
        "forecast_ago AS (\n",
        "    SELECT \n",
        "        `forecast_month` as mes,\n",
        "        CAST(NULL AS DOUBLE) as demanda_real,\n",
        "        CAST(NULL AS DOUBLE) as forecast_julho,\n",
        "        SUM(`forecast_qty`) as forecast_agosto,\n",
        "        CAST(NULL AS DOUBLE) as forecast_setembro\n",
        "    FROM `parts_hdbk_sandbox`.`_agents_databases`.`forecast_enriched`\n",
        "    WHERE 1=1\n",
        "        AND (:material IS NULL OR main_material = :material)\n",
        "        AND `forecast_cycle` = '2026-08-01'\n",
        "        AND `lag` <= 11\n",
        "    GROUP BY `forecast_month`\n",
        "),\n",
        "forecast_set AS (\n",
        "    SELECT \n",
        "        `forecast_month` as mes,\n",
        "        CAST(NULL AS DOUBLE) as demanda_real,\n",
        "        CAST(NULL AS DOUBLE) as forecast_julho,\n",
        "        CAST(NULL AS DOUBLE) as forecast_agosto,\n",
        "        SUM(`forecast_qty`) as forecast_setembro\n",
        "    FROM `parts_hdbk_sandbox`.`_agents_databases`.`forecast_enriched`\n",
        "    WHERE 1=1\n",
        "        AND (:material IS NULL OR main_material = :material)\n",
        "        AND `forecast_cycle` = '2026-09-01'\n",
        "        AND `lag` <= 11\n",
        "    GROUP BY `forecast_month`\n",
        ")\n",
        "SELECT mes, demanda_real, forecast_julho, forecast_agosto, forecast_setembro\n",
        "FROM historico\n",
        "UNION ALL\n",
        "SELECT mes, demanda_real, forecast_julho, forecast_agosto, forecast_setembro\n",
        "FROM forecast_jul\n",
        "UNION ALL\n",
        "SELECT mes, demanda_real, forecast_julho, forecast_agosto, forecast_setembro\n",
        "FROM forecast_ago\n",
        "UNION ALL\n",
        "SELECT mes, demanda_real, forecast_julho, forecast_agosto, forecast_setembro\n",
        "FROM forecast_set\n",
        "ORDER BY mes"
      ],
      "parameters": [
        {
          "displayName": "Material",
          "keyword": "material",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "H0615KRMC00"
                }
              ]
            }
          }
        }
      ]
    }
