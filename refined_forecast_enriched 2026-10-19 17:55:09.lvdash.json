{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "refined_forecast_enriched",
      "config": {
        "version": "1.1",
        "source": "parts_hdbk_sandbox.pr_forecast.refined_forecast_enriched",
        "dimensions": [
          {
            "expr": "source.*"
          },
          {
            "name": "forecast_cycle_label",
            "expr": "DATE_FORMAT(`forecast_cycle`, 'yyyy/MM')",
            "displayName": "Forecast Cycle"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "displayName": "Count",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "page1",
      "displayName": "New Page",
      "layout": [
        {
          "widget": {
            "name": "bar_chart1",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "dataset1",
                  "fields": [
                    {
                      "name": "department",
                      "expression": "`department`"
                    },
                    {
                      "name": "forecast_month",
                      "expression": "`forecast_month`"
                    },
                    {
                      "name": "sum(forecast_qty)",
                      "expression": "SUM(`forecast_qty`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "frame": {
                "showTitle": true,
                "title": {
                  "value": "Forecast Qty por Department",
                  "fields": []
                }
              },
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "forecast_month",
                  "scale": {
                    "type": "categorical",
                    "categorySize": {
                      "type": "number-of-categories",
                      "number": 6
                    }
                  }
                },
                "y": {
                  "fieldName": "sum(forecast_qty)",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "department",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
